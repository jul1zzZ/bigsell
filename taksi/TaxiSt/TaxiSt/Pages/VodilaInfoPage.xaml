<Page x:Class="TaxiSt.Pages.VodilaInfoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TaxiSt.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="VodilaInfoPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Имя" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontSize="20" HorizontalAlignment="Center"/>
        <TextBlock Text="Количество поездок" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontSize="20" HorizontalAlignment="Center"/>
        <TextBlock Text="Автомобиль" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontSize="20" HorizontalAlignment="Center"/>
        <TextBlock Text="Рейтинг" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" FontSize="20" HorizontalAlignment="Center"/>
        <Button x:Name="LoadPhotoBtn" Content="Загрузить фото" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"  HorizontalContentAlignment="Center" Width="150" Height="30" Click="LoadPhotoBtn_Click" Background="Black" Foreground="White" FontWeight="Heavy"/>

        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Width="150" HorizontalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Count}" VerticalAlignment="Center" Width="150" HorizontalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Marka}" VerticalAlignment="Center" Width="150" HorizontalAlignment="Center"/>
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Reiting}" VerticalAlignment="Center" Width="150" HorizontalAlignment="Center"/>
        <Image Grid.Row="4" Grid.Column="1" Source="{Binding GetPhoto}"/>

        <Button x:Name="SaveBtn" Click="SaveBtn_Click" Content="Сохранить" Grid.Row="10" Grid.ColumnSpan="2"  HorizontalAlignment="Center" Width="150" Height="30" VerticalAlignment="Center" Background="Black" Foreground="White" FontWeight="Heavy"/>

    </Grid>
</Page>
