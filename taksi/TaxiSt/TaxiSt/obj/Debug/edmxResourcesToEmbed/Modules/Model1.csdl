    <AssociationSet Name="FK_Taxi_Client" Association="Self.FK_Taxi_Client">
      <End Role="Client" EntitySet="Clients" />
      <End Role="Taxi" EntitySet="Taxis" />
    </AssociationSet>
    <AssociationSet Name="FK_Taxi_Vodila" Association="Self.FK_Taxi_Vodila">
