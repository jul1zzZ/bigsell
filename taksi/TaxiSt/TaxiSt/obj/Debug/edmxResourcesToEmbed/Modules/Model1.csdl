  <Association Name="FK_Taxi_Client">
    <End Role="Client" Type="Self.Client" Multiplicity="1" />
    <End Role="Taxi" Type="Self.Taxi" Multiplicity="*" />
    <ReferentialConstraint>
      <Principal Role="Client">
        <PropertyRef Name="Client_id" />
      </Principal>
      <Dependent Role="Taxi">
        <PropertyRef Name="Client_id" />
      </Dependent>
    </ReferentialConstraint>
  </Association>
  <Association Name="FK_Taxi_Vodila">
    <End Role="Vodila" Type="Self.Vodila" Multiplicity="1" />
    <End Role="Taxi" Type="Self.Taxi" Multiplicity="*" />
    <ReferentialConstraint>
      <Principal Role="Vodila">
        <PropertyRef Name="Voditel_id" />
      </Principal>
      <Dependent Role="Taxi">
        <PropertyRef Name="Voditel_id" />
      </Dependent>
    </ReferentialConstraint>
  </Association>
  <EntityContainer Name="TaxiEntities" annotation:LazyLoadingEnabled="true">
    <EntitySet Name="Clients" EntityType="Self.Client" />
    <EntitySet Name="sysdiagrams" EntityType="Self.sysdiagram" />
    <EntitySet Name="Taxis" EntityType="Self.Taxi" />
    <EntitySet Name="Users" EntityType="Self.User" />
