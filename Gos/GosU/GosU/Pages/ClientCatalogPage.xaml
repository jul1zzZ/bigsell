<Page x:Class="GosU.Pages.ClientCatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GosU.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ClientCatalogPage" IsVisibleChanged="Page_IsVisibleChanged">

    <Grid Background="#ffdadada">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Введите текст для поиска: "/>
            <TextBox x:Name="SearchTb" TextChanged="SearchTb_TextChanged" Margin="0 0 10 0" Width="150"/>
            <TextBlock Text="Сортировка: "/>
            <ComboBox x:Name="SortCb" SelectionChanged="SortCb_SelectionChanged" Margin="0 0 10 0" Width="150">
                <ComboBoxItem Content="По возрастанию"/>
                <ComboBoxItem Content="По убыванию"/>
            </ComboBox>
            <TextBlock Text="Фильтрация: "/>
            <ComboBox x:Name="FiltCb" SelectionChanged="FiltCb_SelectionChanged" Width="150" />
        </StackPanel>
        <ListBox x:Name="ClientLb" Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Width="750">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="450"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Stretch="Uniform" Width="100" Height="100" Source="{Binding GetPhoto}"/>
                        <StackPanel Grid.Column="1" Margin="10 0">
                            <TextBlock FontSize="18" Margin="0 0 0 10">
                                <Run Text="{Binding Surname}"/>
                                <Run Text="{Binding Name}"/>
                                <Run Text="{Binding Patronymic}"/>
                            </TextBlock>
                            <TextBlock FontSize="18" Margin="0 0 0 10">
                                <Run Text="Возраст: "/>
                                <Run Text="{Binding Age}"/>
                            </TextBlock>
                            <TextBlock FontSize="18" Text="{Binding GetGender,StringFormat='{}Пол: {0}'}" Margin="0 0 0 10"/>
                            <TextBlock FontSize="16" Margin=" 0 0 0 10">
                                <Run Text="Адрес проживания: "/>
                                <Run Text="{Binding Street}"/>
                                <Run Text=", "/>
                                <Run Text="{Binding House}"/>
                                <Run Text=", "/>
                                <Run Text="{Binding Apart}"/>
                            </TextBlock>
                            <TextBlock FontSize="16" Margin=" 0 0 0 10" Text="{Binding Phone, StringFormat='{}Номер телефона: {0}'}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Номер страницы: "/>
            <TextBox x:Name="PageCount" Text="1" Width="100" Background="#545d87" Foreground="White"  FontWeight="Heavy" TextChanged="PageCount_TextChanged" VerticalAlignment="Center"/>
            <Button x:Name="prevPage" Content="Prev" Background="#545d87" Foreground="White"  FontWeight="Heavy" Click="prevPage_Click" Width="60" Height="25" Margin="5 0 0 0" />
            <Button x:Name="firstPage" Content="1"  Background="#545d87" Foreground="White"  FontWeight="Heavy" Click="firstPage_Click" Width="50" Height="25" Margin="5 0 0 0" />
            <Button x:Name="secondPage" Content="2" Background="#545d87" Foreground="White"  FontWeight="Heavy" Click="secondPage_Click" Width="50" Height="25" Margin="5 0 0 0" />
            <Button x:Name="nextPage" Content="Next" Background="#545d87" Foreground="White"  FontWeight="Heavy" Click="nextPage_Click" Width="60" Height="25" Margin="5 0 0 0" />
        </StackPanel>
    </Grid>
</Page>
