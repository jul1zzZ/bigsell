<Page x:Class="GosU.Pages.MainButtonPanelPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GosU.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainButtonPanelPage">

    <Grid Background="#ffdadada">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Border MinWidth="400" Margin="15" Background="#fff" Grid.Row="1" VerticalAlignment="Center" Padding="30" MaxWidth="350" CornerRadius="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="60" Color="LightGray" ShadowDepth="0"/>
            </Border.Effect>
            <StackPanel>
                <Button x:Name="ClientBtn" Width="150" Height="30" Content="Клиенты" Click="ClientBtn_Click" Margin="0 10"  Background="#545d87" Foreground="White"  FontWeight="Heavy"/>
                <Button x:Name="ServiceBtn" Width="150" Height="30" Content="Услуги" Click="ServiceBtn_Click" Margin="0 10"  Background="#545d87" Foreground="White"  FontWeight="Heavy"/>
                <Button x:Name="SocialBtn" Width="150" Height="30" Content="Социальная позиция" Click="SocialBtn_Click" Margin="0 10"  Background="#545d87" Foreground="White"  FontWeight="Heavy"/>
            </StackPanel> 
        </Border>
    </Grid>
</Page>
