<Page x:Class="stay.Pages.AddStayPage1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:stay.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddStayPage1">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
        </Grid.RowDefinitions>
        <DataGrid x:Name="DataStay" Grid.Row="0" AutoGenerateColumns="False"
            IsReadOnly="True" RowHeight="30" SelectionMode="Single"
            LoadingRow="DataStay_LoadingRow">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="100" Header="Изображение">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding Path=GetPhoto}"></Image>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Binding="{Binding name_specialization}" Header="специальность"
                    Width="150"></DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding price, StringFormat='c', ConverterCulture='ru-RU'}" Width="200" Header="Стоимость"></DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding name_time}" Header="Срок обучение"
                    Width="150"></DataGridTextColumn>
                <DataGridTemplateColumn Width="*" Header="Редактировать">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Name="BtnEdit" Content="♡" Click="BtnEdit_Click_1"  Margin="0"></Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Button Grid.Row="1" x:Name="BtnNaz" Click="BtnNaz_Click" Content="Назад" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Width ="200" Height="40" Margin="570,5,30,5" RenderTransformOrigin="-0.279,0.599"/>
        <Button Grid.Row="1" x:Name="BtnDelete" Click="BtnDelete_Click" Content="Удалить" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Width="200" Height="40" />
        <Button Grid.Row="1" x:Name="BtnDob" Click="BtnDob_Click" Content="Добавить" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="14" Width="200" Height="40"/>
    </Grid>
</Page>
