<Page x:Class="stay.Pages.GoodAddStay"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:stay.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="GoodAddStay">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Специальность" Height="40" FontSize="20" Margin="5" Grid.Column="0" Grid.Row="0"/>
        <TextBlock Text="Стоимость" FontSize="20" Height="40" Margin="5" Grid.Row="1"/>
        <TextBlock Text="Срок обучения" FontSize="20" Grid.Row="2" Height="40" Margin="5"/>
        <TextBlock Text="Изображение" FontSize="20" Grid.Row="3" Height="40" Margin="5"/>
        <TextBlock Text="Направление" FontSize="20" Grid.Row="4" Height="40" Margin="5"/>
        <TextBlock Text="Форма обучения" FontSize="20" Grid.Row="5" Height="40" Margin="5"/>
        <TextBlock Text="Бюджетные места" FontSize="20" Grid.Row="7" Height="40" Margin="5"/>
        <TextBlock Text="Платные места" FontSize="20" Grid.Row="8" Height="40" Margin="5"/>
        <TextBox x:Name="TxtSpecialization" Width="350" Height="40" Margin="5" Grid.Column="1" Grid.Row="0" Text="{Binding name_specialization}"/>
        <TextBox x:Name="TxtPrice" Width="350" Height="40" Margin="5" Grid.Column="1" Grid.Row="1" Text="{Binding price}"/>
        <TextBox x:Name="TxtTime" Grid.Row="2" Grid.Column="1" Height="40" Width="350" Text="{Binding name_time}"/>
        <ComboBox Name="CmbMode" Grid.Column="1" Grid.Row="5" Height="40" Width="350" SelectedItem="{Binding mode}" DisplayMemberPath="name_mode" HorizontalAlignment="Left" Margin="20,0" />
        <Image x:Name="Image" Source="{Binding Path=GetPhoto}" Grid.Row="3" Grid.Column="0" Width="60" Height="60" Margin="20,0"/>
        <Button x:Name="LoagImage" Grid.Row="9" Content="Загрузить" Height="20" Background="RosyBrown" Click="LoagImage_Click"  Margin="245,14,10,10" Grid.Column="1"/>
        <ComboBox Name="CmbNaprav" Grid.Column="1" Grid.Row="4" Height="40" Width="350"
                  SelectedItem="{Binding direction}" DisplayMemberPath="name_directions"  HorizontalAlignment="Left" Margin="20,0"/>
        <ComboBox Name="CmbStaff" Grid.Row="6" Grid.Column="1" Width="350" Height="40" SelectedItem="{Binding staff}" DisplayMemberPath="id_staff" HorizontalAlignment="Left" Margin="20,0"/>
        <Button x:Name="BtnSave" Grid.Row="9" Height="20" Content="Сохранить" Background="RosyBrown" Click="BtnSave_Click"  Margin="10,10,245,14"/>
        <TextBlock Text="Куратор"  Grid.Row="6" FontSize="20" Height="40" Margin="5"/>

        <TextBox x:Name="TxtBudget" Width="350" Height="40" Margin="20,0" Grid.Column="1" Grid.Row="7" Text="{Binding budget}"/>
        <TextBox x:Name="TxtPaid" Width="350" Height="40" Margin="5" Grid.Column="1" Grid.Row="8" Text="{Binding paid}"/>
        <Button Grid.Row="9" Click="Button_Click"  Content="Назад" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="14" Height="20" Width="145" Margin="0,14,0,10" RenderTransformOrigin="-0.444,2.575" Background="RosyBrown" Grid.Column="1"/>
    </Grid>
</Page>
