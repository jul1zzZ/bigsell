        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="entrants">
      <EntityTypeMapping TypeName="stayModel.entrant">
        <MappingFragment StoreEntitySet="entrant">
          <ScalarProperty Name="id_entrant" ColumnName="id_entrant" />
