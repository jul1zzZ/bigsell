<?xml version="1.0" encoding="utf-8"?>
<Mapping Space="C-S" xmlns="http://schemas.microsoft.com/ado/2009/11/mapping/cs">
  <EntityContainerMapping StorageEntityContainer="Хранилище stayModelContainer" CdmEntityContainer="stayEntities">
    <EntitySetMapping Name="directions">
      <EntityTypeMapping TypeName="stayModel.direction">
        <MappingFragment StoreEntitySet="directions">
          <ScalarProperty Name="id_directions" ColumnName="id_directions" />
