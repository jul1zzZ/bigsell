<Page x:Class="Magazin.Pages.ADMPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Magazin.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ADMPage" Style="{StaticResource base_page}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="ПАРОЛЬ" FontSize="50" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="1"/>


        <TextBox x:Name="PB" Grid.Column="1" Text="{Binding pass}" Width="300" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Пароль 0000" Grid.Row="1"/>
        <Button x:Name="NEXT" Content="Далее" Grid.Column="1" Style="{StaticResource base_button}" Grid.Row="2"  Width="100" Height="30" VerticalAlignment="Top" Click="NEXT_Click"/>
        <Button x:Name="Back" Content="Отмена" Grid.Column="1" Style="{StaticResource base_button}" Height="30" Width="100" Grid.Row="5" VerticalAlignment="Center" Click="Back_Click"/>
        <Button x:Name="REG" Content="Регистрация" Grid.Column="1" Style="{StaticResource base_button}" Grid.Row="5" Width="100" Height="30" VerticalAlignment="Top" Click="REG_Click"
                />

    </Grid>
</Page>
