<Page x:Class="Magazin.Pages.EditZapiz"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Magazin.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EditZapiz" Style="{StaticResource base_page}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Фамилия" FontSize="20" Height="40" Grid.Row="1"/>
        <TextBlock Text="Название книги" FontSize="20" Height="40" Grid.Row="3"/>
        <TextBlock Text="Дата взятия книги" FontSize="20" Height="40" Grid.Row="5"/>
        <TextBlock Text="Дата отдачи книги" FontSize="20" Height="40" Grid.Row="6"/>

        <ComboBox x:Name="userFCb" DisplayMemberPath="last_name" SelectedItem="{Binding user}" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"/>
        <ComboBox x:Name="bookCb" SelectedItem="{Binding book}" Width="350"  Height="40" Grid.Column="1" Grid.Row="3" DisplayMemberPath="book_name"/>
        <TextBox x:Name="TxtID3" Width="350"  Height="40" Grid.Column="1" Grid.Row="5" DatePicker.SelectedDateChanged="TxtID4_SelectedDateChanged" Text="{Binding time_start}"/>
        <TextBox x:Name="TxtID4" Width="350"  Height="40" Grid.Column="1" Grid.Row="6" DatePicker.SelectedDateChanged="TxtID4_SelectedDateChanged" Text="{Binding time_end}"/>
        

        <Button x:Name="BtnSave" Grid.Row="7" Width="200" Height="40" Content="Сохранить" Style="{StaticResource base_button}" Click="BtnSave_Click" Margin="100,12,100,12"/>

        <Button x:Name="Back" Grid.Row="7" Grid.Column="1" Width="200" Height="40" Content="Отмена" Style="{StaticResource base_button}" Click="Back_Click" Margin="100,12,100,12"/>
    </Grid>
</Page>
