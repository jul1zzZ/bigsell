<Page x:Class="Magazin.Pages.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Magazin.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegPage"  Style="{StaticResource base_page}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Логин"   FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="1"/>
        <TextBlock Text="Пароль" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="2"/>
        <TextBlock Text="Имя" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="3"/>
        <TextBlock Text="Фамилия" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="4"/>
        <TextBox x:Name="loginTB" Text="{Binding name}" Grid.Column="1" Width="300" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Иван" Grid.Row="3"/>
        <TextBox x:Name="NameTB" Text="{Binding last_name}" Grid.Column="1" Width="300" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Иванов" Grid.Row="4"/>
        <TextBox x:Name="LoginTB" Text="{Binding login}" Grid.Column="1" Width="300" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Логин 1234" Grid.Row="1"/>
        <TextBox x:Name="PB" Text="{Binding pass}" Grid.Column="1" Width="300" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Пароль 1234" Grid.Row="2"/>

        <Button x:Name="REG" Content="Регестрация" Grid.Column="1" Style="{StaticResource base_button}" Grid.Row="5" Width="100" Height="30" VerticalAlignment="Top" Click="REG_Click"/>
        <Button x:Name="Back" Content="Отмена" Grid.Column="1" Style="{StaticResource base_button}" Height="30" Width="100" Grid.Row="5" VerticalAlignment="Center" Click="Back_Click"/>

   
    </Grid>
</Page>
