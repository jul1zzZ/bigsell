        <PropertyRef Name="EmoloyeeID" />
      </Principal>
      <Dependent Role="Perfomance">
        <PropertyRef Name="EmployeeID" />
      </Dependent>
    </ReferentialConstraint>
  </Association>
  <Association Name="FK_Perfomance_Service">
    <End Role="Service" Type="Self.Service" Multiplicity="1" />
    <End Role="Perfomance" Type="Self.Perfomance" Multiplicity="*" />
    <ReferentialConstraint>
      <Principal Role="Service">
        <PropertyRef Name="ServiceID" />
      </Principal>
      <Dependent Role="Perfomance">
        <PropertyRef Name="ServiceID" />
      </Dependent>
    </ReferentialConstraint>
  </Association>
  <EntityContainer Name="AdvAgEntities" annotation:LazyLoadingEnabled="true">
    <EntitySet Name="Auths" EntityType="Self.Auth" />
    <EntitySet Name="Clients" EntityType="Self.Client" />
    <EntitySet Name="Employees" EntityType="Self.Employee" />
    <EntitySet Name="Perfomances" EntityType="Self.Perfomance" />
    <EntitySet Name="Posts" EntityType="Self.Post" />
    <EntitySet Name="Roles" EntityType="Self.Role" />
    <EntitySet Name="Services" EntityType="Self.Service" />
    <EntitySet Name="sysdiagrams" EntityType="Self.sysdiagram" />
    <AssociationSet Name="FK_Auth_Role" Association="Self.FK_Auth_Role">
      <End Role="Role" EntitySet="Roles" />
      <End Role="Auth" EntitySet="Auths" />
    </AssociationSet>
    <AssociationSet Name="FK_Perfomance_Client" Association="Self.FK_Perfomance_Client">
      <End Role="Client" EntitySet="Clients" />
      <End Role="Perfomance" EntitySet="Perfomances" />
    </AssociationSet>
    <AssociationSet Name="FK_Employee_Post" Association="Self.FK_Employee_Post">
      <End Role="Post" EntitySet="Posts" />
      <End Role="Employee" EntitySet="Employees" />
    </AssociationSet>
    <AssociationSet Name="FK_Perfomance_Employee" Association="Self.FK_Perfomance_Employee">
      <End Role="Employee" EntitySet="Employees" />
      <End Role="Perfomance" EntitySet="Perfomances" />
    </AssociationSet>
    <AssociationSet Name="FK_Perfomance_Service" Association="Self.FK_Perfomance_Service">
      <End Role="Service" EntitySet="Services" />
      <End Role="Perfomance" EntitySet="Perfomances" />
    </AssociationSet>
  </EntityContainer>
</Schema>