<Page x:Class="Librar.Pages.BookInfoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Librar.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BookInfoPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Название" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <TextBlock Text="Автор" FontSize="20" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <TextBlock Text="Дата публикации" FontSize="20" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <TextBlock Text="Количество в библиотеке" FontSize="20" Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <Button x:Name="LoadPhotoBtn" Content="Загрузить фото" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" HorizontalContentAlignment="Center" Width="150" Height="30" Click="LoadPhotoBtn_Click" Background="#a1b3d1" Foreground="Black" FontWeight="Heavy"/>
        <Image Grid.Row="4" Grid.Column="1" Source="{Binding GetPhoto}"/>
        <Button x:Name="SaveBtn" Click="SaveBtn_Click" Content="Сохранить" Grid.Row="10" Grid.ColumnSpan="2" Height="30" HorizontalAlignment="Center" Width="150" VerticalAlignment="Center" Background="#a1b3d1" Foreground="Black" FontWeight="Heavy"/>
        <TextBox Text="{Binding Name}" VerticalAlignment="Center" Grid.Row="0" Grid.Column="1" Width="250" Height="30"/>
        <ComboBox x:Name="AuthorCb" DisplayMemberPath="Surname"  SelectedItem="{Binding Author}" Grid.Row="1" Width="250" Grid.Column="1" VerticalAlignment="Center"/>
        <TextBox Text="{Binding PubDate}" VerticalAlignment="Center" Grid.Row="2" Grid.Column="1" Width="250" Height="30"/>
        <TextBox Text="{Binding Amount}" VerticalAlignment="Center" Grid.Row="3" Grid.Column="1" Width="250" Height="30"/>
    </Grid>
</Page>
