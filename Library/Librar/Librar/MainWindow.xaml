<Window x:Class="Librar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Librar"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="#ffdadada">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="#c3c6c9"/>
        <TextBlock Text="School Library" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Heavy" FontSize="28"/>
        <Image Grid.Row="0" Source="Resources\1.png" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10 0" Height="120" Width="120"/>
        <Grid Grid.Row="2" Background="#c3c6c9"/>
        <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden" ContentRendered="MainFrame_ContentRendered"/>
        <Button x:Name="BackBtn" Content="Назад" Grid.Row="0" Width="70" Background="#a1b3d1"  Foreground="Black" FontWeight="Heavy" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0 0 20 0"  Click="BackBtn_Click"/>
        <Button x:Name="ListBtn" Content="Клиент" Grid.Row="0" Width="70" Background="#a1b3d1" Foreground="Black" FontWeight="Heavy" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="110 0"  Click="ListBtn_Click"/>
    </Grid>
</Window>
