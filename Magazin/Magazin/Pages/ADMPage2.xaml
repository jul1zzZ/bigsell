<Page x:Class="Magazin.Pages.ADMPage2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Magazin.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ADMPage2" Style="{StaticResource base_page}" IsVisibleChanged="Page_IsVisibleChanged">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#e7fabf">

            <TextBlock Text="Введите название для поиска" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBox x:Name="TBNAZ" Width="200" TextChanged="TBNAZ_TextChanged"/>

            <Label Content="По стоимости:" Foreground="#04a0ff"></Label>
            <ComboBox Name="CmbCost" DisplayMemberPath="" SelectionChanged="CmbCost_SelectionChanged">
                <ComboBoxItem Content="По возрастанию"/>
                <ComboBoxItem Content="По убыванию"/>
            </ComboBox>
            <Label Content="По скидке:" Foreground="#04a0ff"></Label>
            <ComboBox Name="CmbSale" DisplayMemberPath="" SelectionChanged="CmbSale_SelectionChanged">
                <ComboBoxItem Content="Все"/>
                <ComboBoxItem Content="от 5% до 15%"/>
                <ComboBoxItem Content="от 15% до 30%"/>
                <ComboBoxItem Content="от 30% до 70%"/>
                <ComboBoxItem Content="от 70% до 100%"/>
            </ComboBox>
        </StackPanel>
        <ListView Grid.Row="1" Name="ListUslugi" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ListUslugi_SelectionChanged">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel HorizontalAlignment="Center" Orientation="Vertical"></WrapPanel>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="2" CornerRadius="5" BorderThickness="1" BorderBrush="Gray">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="60"></RowDefinition>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Background="{Binding GetColor}" Grid.RowSpan="2">
                                <Image Source="{Binding Path=GetPhoto}" Width="70" Height="70" ></Image>
                                <StackPanel Margin="20,0,0,0">
                                    <TextBlock Text="{Binding Naimenovanie}" TextWrapping="Wrap" Width="500"></TextBlock>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Stoimost, StringFormat={}{0} рублей}" TextDecorations="Strikethrough"></TextBlock>
                                        <TextBlock Text="{Binding Prodolgit, StringFormat={} за {0} минут}"></TextBlock>
                                    </StackPanel>
                                    <TextBlock Text="{Binding GetPrice, StringFormat={}Цена с учетом скидки: {0} рублей}" TextAlignment="Left"></TextBlock>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="EditBtn" Content="Редактировать" Click="EditBtn_Click" Margin="5" Padding="5" Style="{StaticResource base_button}"/>
                                        <Button x:Name="DeleteBtn" Content="Удалить" Click="DeleteBtn_Click" Margin="5" Padding="5" Style="{StaticResource base_button}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="2" Background="#e7fabf">
            <Button x:Name="ZAP" Content="Запись Клиента" Style="{StaticResource base_button}" VerticalAlignment="Center" HorizontalAlignment="Right" Height="25" Click="ZAP_Click"/>
            <Button x:Name="Dobav" Content="Добавить" Style="{StaticResource base_button}" VerticalAlignment="Center" HorizontalAlignment="Left" Height="25" Click="Dobav_Click"/>
            <Button x:Name="Home" Content="Домой" Style="{StaticResource base_button}" VerticalAlignment="Center" HorizontalAlignment="Center" Height="25" Click="Home_Click"/>
        </Grid>

    </Grid>
</Page>
