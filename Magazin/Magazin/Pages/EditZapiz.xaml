<Page x:Class="Magazin.Pages.EditZapiz"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Magazin.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EditZapiz" Style="{StaticResource base_page}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Фамилия" FontSize="20" Height="40" Grid.Row="1"/>
        <TextBlock Text="Имя" FontSize="20" Height="40" Grid.Row="2"/>
        <TextBlock Text="Услуга" FontSize="20" Height="40" Grid.Row="3"/>
        <TextBlock Text="Время начало услуги" FontSize="20" Height="40" Grid.Row="4"/>
        <TextBlock Text="Дата начало услуги" FontSize="20" Height="40" Grid.Row="5"/>
        <TextBlock Text="Комментарий" FontSize="20" Height="40" Grid.Row="6"/>

        <ComboBox x:Name="FamilCmb" Width="350" Height="40" Grid.Column="1" Grid.Row="1" SelectedItem="{Binding Klient}" DisplayMemberPath="Famil"></ComboBox>
        <ComboBox x:Name="KlientCmb" Width="350"  Height="40" Grid.Column="1" Grid.Row="2" SelectedItem="{Binding Klient}" DisplayMemberPath="Imya"/>
            <ComboBox x:Name="UslugiCmb" Width="350"  Height="40" Grid.Column="1" Grid.Row="3" SelectedItem="{Binding Yslyga}" DisplayMemberPath="Naimenovanie"/>
        <TextBox x:Name="TxtID3" Width="350"  Height="40" Grid.Column="1" Grid.Row="4" Text="{Binding Vremya_nachala_yslygi}"/>
        <TextBox x:Name="TxtID4" Width="350"  Height="40" Grid.Column="1" Grid.Row="5" DatePicker.SelectedDateChanged="TxtID4_SelectedDateChanged" Text="{Binding Data_nachala_yslygi}"/>
        <TextBox x:Name="TxtID5" Width="350"  Height="40" Grid.Column="1" Grid.Row="6" Text="{Binding Koment}"/>

        <Button x:Name="BtnSave" Grid.Row="7" Width="200" Height="40" Content="Сохранить" Style="{StaticResource base_button}" Click="BtnSave_Click" Margin="100,12,100,12"/>

        <Button x:Name="Back" Grid.Row="7" Grid.Column="1" Width="200" Height="40" Content="Отмена" Style="{StaticResource base_button}" Click="Back_Click" Margin="100,12,100,12"/>
    </Grid>
</Page>
