<Window x:Class="Storehouse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Storehouse"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="#ffdadada">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="#c3c6c9"/>
        <TextBlock Text="Storehouse" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="28"/>
        <Image Grid.Row="0"  VerticalAlignment="Center" Source="\Resources\124434.png" HorizontalAlignment="Left" Margin="10 0" Height="80" Width="80"/>
        <Grid Grid.Row="2" Background="#c3c6c9"/>
        <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden" ContentRendered="MainFrame_ContentRendered"/>
        <Button x:Name="BackBtn" Content="Back" Click="BackBtn_Click" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="0" Foreground="AliceBlue" Background="DarkCyan" Height="30" Width="60" Margin="20 0"/>
        <Button x:Name="TableBtn" Content="Table" Click="TableBtn_Click" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="0" Foreground="AliceBlue" Background="DarkCyan" Height="30" Width="60" Margin="100 0"/>
    </Grid>
</Window>
