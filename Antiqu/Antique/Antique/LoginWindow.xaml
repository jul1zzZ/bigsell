<Window x:Class="Antique.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Antique"
        mc:Ignorable="d"
        Title="LoginWindow" Height="400" Width="600">
    <Grid Background=" #6b6667">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Border MinWidth="400" Margin="15" Background="LightGray" Grid.Row="1" VerticalAlignment="Center" Padding="30" MaxWidth="250" CornerRadius="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="60" Color="DimGray" ShadowDepth="0"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Вход в приложение" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="30" FontWeight="Bold" Margin="0 0 0 20"/>
                <TextBox x:Name="LoginTb" Margin="0 0 0 20" Width="250" Text="{Binding Login}" />
                <TextBox x:Name="PassTb" Width="250" Text="{Binding Password}"/>
                <Grid>
                    <Button x:Name="LoginBtn" Click="LoginBtn_Click" Content="Войти" HorizontalAlignment="Center" Margin="0 20" Width="100" Background="AntiqueWhite" Foreground="#574348" FontWeight="UltraBlack"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
