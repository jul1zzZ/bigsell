<Page x:Class="Antique.Pages.InfoAntiquePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Antique.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="InfoAntiquePage">

    <Grid Background="#ffdadada">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Автор" Grid.Row="0" FontSize="20" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#574348" FontWeight="UltraBlack"/>
        <TextBlock Text="Наличие" Grid.Row="1" FontSize="20" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#574348" FontWeight="UltraBlack"/>
        <TextBlock Text="Цена" Grid.Row="2" FontSize="20" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#574348" FontWeight="UltraBlack"/>
        <TextBlock Text="Страна" Grid.Row="3" FontSize="20" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#574348" FontWeight="UltraBlack"/>
        <TextBlock Text="Год" Grid.Row="4" FontSize="20" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#574348" FontWeight="UltraBlack"/>
        <Button x:Name="LoadPhotoBtn" Content="Загрузить фото" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" HorizontalContentAlignment="Center" Width="150" Click="LoadPhotoBtn_Click"  Background="AntiqueWhite" Foreground="#574348" FontWeight="UltraBlack" Height="36" FontSize="15"/>
        <Image Grid.Row="5" Grid.Column="1" Source="{Binding GetPhoto}"/>
        <Button x:Name="SaveBtn" Click="SaveBtn_Click" Content="Сохранить" Grid.Row="10" Grid.ColumnSpan="2"  HorizontalAlignment="Center" VerticalAlignment="Center" Background="AntiqueWhite" Foreground="#574348" Width="150" FontWeight="UltraBlack" Height="36" FontSize="15"/>
        <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding Author}" Width="150" Height="20"  VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding Presence}" Width="150" Height="20"  VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" Grid.Row="2" Text="{Binding Price}" Width="150" Height="20"  VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" Grid.Row="3" Text="{Binding ProdCount}" Width="150" Height="20"  VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" Grid.Row="4" Text="{Binding ProdYear}" Width="150" Height="20"  VerticalAlignment="Center"/>
    </Grid>
</Page>
