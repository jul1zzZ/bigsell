<Window x:Class="Pawnshop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pawnshop"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="FloralWhite">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid Background="CornflowerBlue" Grid.Row="2"/>
        <Grid Background="CornflowerBlue" Grid.Row="0"/>
        <TextBlock Text="Pawnshop" Foreground="AliceBlue" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="60" FontWeight="DemiBold"/>
        <Image Source="C:\Users\witless\Desktop\Lomb\Pawnshop\Pawnshop\Resources\logo.png" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Left" Width="80" Height="80" Margin="10 0"/>
        <Frame Grid.Row="1" ContentRendered="Frame_ContentRendered" NavigationUIVisibility="Hidden" x:Name="MainFrame"/>
        <Button x:Name="BackBtn" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Right" Width="90" Height="30" Content="Back" Background="AliceBlue" Foreground="CornflowerBlue" FontWeight="Bold" Margin="10 0"
                Click="BackBtn_Click"/>
        <Button x:Name="ListBtn" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Right" Width="90" Height="30" Content="Table" Background="AliceBlue" Foreground="CornflowerBlue" FontWeight="Bold" Margin="110 0" Click="ListBtn_Click"/>
    </Grid>
</Window>
