<Page x:Class="Pawnshop.Pages.EditPawnPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pawnshop.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EditPawnPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Категория" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"/>
        <TextBlock Text="Клиент" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"/>
        <TextBlock Text="Описание" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"/>
        <TextBlock Text="Дата сдачи" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"/>
        <TextBlock Text="Деньги на руки" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"/>
        <TextBlock Text="Комиссия" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"/>
        <TextBlock Text="Дата возврата" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"/>
        <Button x:Name="LoadPhotoBtn" Content="Загрузить фото" Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" HorizontalContentAlignment="Center" Width="150" Height="30" Background="CornflowerBlue" Foreground="AliceBlue" FontWeight="Bold" Click="LoadPhotoBtn_Click"/>

        <ComboBox x:Name="catCb" DisplayMemberPath="Name" SelectedItem="{Binding ChangeCategory}" Grid.Row="0" Width="250" Height="25" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <ComboBox x:Name="ClientCb" DisplayMemberPath="Surname" SelectedItem="{Binding Client}" Grid.Row="1" Width="250" Height="25" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Descr}" VerticalAlignment="Center" Width="250" Height="25"/>
        <DatePicker x:Name="DateCb" Grid.Row="3" Grid.Column="1" Text="{Binding DateChange}" VerticalAlignment="Center" Width="250" Height="25"/>
        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding MoneyHand}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="250" Height="25"/>
        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Commissor}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="250" Height="25"/>
        <DatePicker x:Name="DateRCb" Grid.Row="6" Grid.Column="1" Text="{Binding DateChange}" VerticalAlignment="Center" Width="250" Height="25"/>
        <Image Grid.Row="7" Grid.Column="1" Source="{Binding GetPhoto}"/>
        <Button x:Name="SaveBtn" Click="SaveBtn_Click" Content="Сохранить" Grid.Row="8" Grid.ColumnSpan="2" Background="CornflowerBlue" Foreground="AliceBlue" Width="150" Height="30" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

    </Grid>
</Page>
