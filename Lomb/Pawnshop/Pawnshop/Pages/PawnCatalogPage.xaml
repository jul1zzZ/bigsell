<Page x:Class="Pawnshop.Pages.PawnCatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pawnshop.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PawnCatalogPage" IsVisibleChanged="Page_IsVisibleChanged">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Введите текст для поиска: "/>
            <TextBox x:Name="SearchTb" TextChanged="SearchTb_TextChanged" Margin="0 0 10 0" Width="150"/>
            <TextBlock Text="Сортировка: "/>
            <ComboBox x:Name="SortCb" SelectionChanged="SortCb_SelectionChanged" Margin="0 0 10 0" Width="150">
                <ComboBoxItem Content="По возрастанию"/>
                <ComboBoxItem Content="По убыванию"/>
            </ComboBox>
            <TextBlock Text="Фильтрация: "/>
            <ComboBox x:Name="FiltCb" SelectionChanged="FiltCb_SelectionChanged" Width="150"/>
        </StackPanel>
        <ListBox x:Name="PawnLb" Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Width="700" >
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="450"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Stretch="Uniform" Width="100" Height="100" Source="{Binding GetPhoto}"/>
                        <StackPanel Grid.Column="1" Margin="10 0 0 10">
                            <TextBlock FontSize="18" Margin="0 0 0 10">
                                <Run Text="{Binding ChangeCategory.Name}"/>
                                <Run Text="||"/>
                                <Run Text="{Binding Descr}"/>
                            </TextBlock>
                            <TextBlock FontSize="16" Margin="0 0 0 10">
                                <Run Text="Деньги на руки: "/>
                                <Run Text="{Binding MoneyHand}"/>
                            </TextBlock>
                            <TextBlock FontSize="16" Margin="0 0 0 10">
                                <Run Text="Комиссия: "/>
                                <Run Text="{Binding Commissor}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Номер страницы: "/>
            <TextBox x:Name="PageCount" Text="1" Width="100" TextChanged="PageCount_TextChanged" VerticalAlignment="Center"/>
            <Button x:Name="prevPage" Content="Prev" Click="prevPage_Click" Width="60" Background="AliceBlue" Foreground="CornflowerBlue" FontWeight="Bold" Height="25" Margin="5 0 0 0"/>
            <Button x:Name="firstPage" Content="1" Click="firstPage_Click" Width="50" Background="AliceBlue" Foreground="CornflowerBlue" FontWeight="Bold" Height="25" Margin="5 0 0 0"/>
            <Button x:Name="secondPage" Content="2" Click="secondPage_Click" Width="50" Background="AliceBlue" Foreground="CornflowerBlue" FontWeight="Bold" Height="25" Margin="5 0 0 0"/>
            <Button x:Name="nextPage" Content="Next" Click="nextPage_Click" Background="AliceBlue" Foreground="CornflowerBlue" FontWeight="Bold" Width="60" Height="25" Margin="5 0 0 0"/>
        </StackPanel>
    </Grid>
</Page>
