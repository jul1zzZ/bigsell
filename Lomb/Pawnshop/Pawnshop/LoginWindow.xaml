<Window x:Class="Pawnshop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pawnshop"
        mc:Ignorable="d"
        Title="LoginWindow" Height="350" Width="450" WindowStartupLocation="CenterScreen">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid Background="CornflowerBlue" Grid.ColumnSpan="2"/>
        <Grid Background="CornflowerBlue" Grid.Row="3" Grid.ColumnSpan="2"/>
        <TextBlock Text="Authorization" FontSize="30" Grid.ColumnSpan="2" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <Image Source="C:\Users\witless\Desktop\Lomb\Pawnshop\Pawnshop\Resources\logo.png" Width="100" Height="100" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10 0"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Login" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Password" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"/>
        <TextBox x:Name="LoginTb" Grid.Row="1" Grid.Column="1" Text="{Binding Login}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="170" Height="30"/>
        <TextBox x:Name="PassTb"  Grid.Row="2" Grid.Column="1" Text="{Binding Password}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="170" Height="30"/>
        <Button x:Name="BtnLog" Grid.Row="3" Grid.ColumnSpan="2"  VerticalAlignment="Center" HorizontalAlignment="Center" Height="30" Width="100" Click="BtnLog_Click" Content="Enter" FontSize="20" Background="AliceBlue" Foreground="CornflowerBlue" FontWeight="Bold"/>
    </Grid>
</Window>
