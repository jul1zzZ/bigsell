    </AssociationSet>
    <AssociationSet Name="FK_Sale_Change" Association="Self.FK_Sale_Change">
      <End Role="Change" EntitySet="Changes" />
      <End Role="Sale" EntitySet="Sales" />
    </AssociationSet>
  </EntityContainer>
</Schema>