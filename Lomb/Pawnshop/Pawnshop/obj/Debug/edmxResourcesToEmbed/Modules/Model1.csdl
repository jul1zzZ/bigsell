    <Property Name="ChangeID" Type="Int32" Nullable="false" />
    <NavigationProperty Name="Change" Relationship="Self.FK_Sale_Change" FromRole="Sale" ToRole="Change" />
  </EntityType>
  <EntityType Name="sysdiagram">
    <Key>
      <PropertyRef Name="diagram_id" />
    </Key>
    <Property Name="name" Type="String" MaxLength="128" FixedLength="false" Unicode="true" Nullable="false" />
    <Property Name="principal_id" Type="Int32" Nullable="false" />
    <Property Name="diagram_id" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="Identity" />
    <Property Name="version" Type="Int32" />
    <Property Name="definition" Type="Binary" MaxLength="Max" FixedLength="false" />
  </EntityType>
  <Association Name="FK_Auth_Role">
    <End Role="Role" Type="Self.Role" Multiplicity="1" />
    <End Role="Auth" Type="Self.Auth" Multiplicity="*" />
    <ReferentialConstraint>
      <Principal Role="Role">
        <PropertyRef Name="RoleID" />
      </Principal>
      <Dependent Role="Auth">
        <PropertyRef Name="RoleID" />
      </Dependent>
    </ReferentialConstraint>
  </Association>
  <Association Name="FK_Change_ChangeCategory">
    <End Role="ChangeCategory" Type="Self.ChangeCategory" Multiplicity="1" />
    <End Role="Change" Type="Self.Change" Multiplicity="*" />
    <ReferentialConstraint>
      <Principal Role="ChangeCategory">
        <PropertyRef Name="ChangeCategoryID" />
      </Principal>
      <Dependent Role="Change">
        <PropertyRef Name="ChangeCategoryID" />
      </Dependent>
    </ReferentialConstraint>
  </Association>
  <Association Name="FK_Change_Client">
    <End Role="Client" Type="Self.Client" Multiplicity="1" />
    <End Role="Change" Type="Self.Change" Multiplicity="*" />
    <ReferentialConstraint>
      <Principal Role="Client">
        <PropertyRef Name="ClientID" />
      </Principal>
      <Dependent Role="Change">
        <PropertyRef Name="ClientID" />
      </Dependent>
    </ReferentialConstraint>
  </Association>
  <Association Name="FK_Sale_Change">
    <End Role="Change" Type="Self.Change" Multiplicity="1" />
    <End Role="Sale" Type="Self.Sale" Multiplicity="*" />
    <ReferentialConstraint>
      <Principal Role="Change">
        <PropertyRef Name="ChangeID" />
      </Principal>
      <Dependent Role="Sale">
        <PropertyRef Name="ChangeID" />
      </Dependent>
    </ReferentialConstraint>
  </Association>
  <EntityContainer Name="PawnShopEntities" annotation:LazyLoadingEnabled="true">
    <EntitySet Name="Auths" EntityType="Self.Auth" />
    <EntitySet Name="Changes" EntityType="Self.Change" />
    <EntitySet Name="ChangeCategories" EntityType="Self.ChangeCategory" />
    <EntitySet Name="Clients" EntityType="Self.Client" />
    <EntitySet Name="Roles" EntityType="Self.Role" />
    <EntitySet Name="Sales" EntityType="Self.Sale" />
    <EntitySet Name="sysdiagrams" EntityType="Self.sysdiagram" />
    <AssociationSet Name="FK_Auth_Role" Association="Self.FK_Auth_Role">
      <End Role="Role" EntitySet="Roles" />
      <End Role="Auth" EntitySet="Auths" />
    </AssociationSet>
    <AssociationSet Name="FK_Change_ChangeCategory" Association="Self.FK_Change_ChangeCategory">
      <End Role="ChangeCategory" EntitySet="ChangeCategories" />
