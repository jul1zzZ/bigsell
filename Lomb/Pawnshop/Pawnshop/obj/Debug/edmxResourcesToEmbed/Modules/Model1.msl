<?xml version="1.0" encoding="utf-8"?>
<Mapping Space="C-S" xmlns="http://schemas.microsoft.com/ado/2009/11/mapping/cs">
  <EntityContainerMapping StorageEntityContainer="Хранилище PawnShopModelContainer" CdmEntityContainer="PawnShopEntities">
    <EntitySetMapping Name="Auths">
      <EntityTypeMapping TypeName="PawnShopModel.Auth">
        <MappingFragment StoreEntitySet="Auth">
          <ScalarProperty Name="UserID" ColumnName="UserID" />
          <ScalarProperty Name="Login" ColumnName="Login" />
          <ScalarProperty Name="Password" ColumnName="Password" />
          <ScalarProperty Name="RoleID" ColumnName="RoleID" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="Changes">
      <EntityTypeMapping TypeName="PawnShopModel.Change">
        <MappingFragment StoreEntitySet="Change">
          <ScalarProperty Name="ChangeID" ColumnName="ChangeID" />
          <ScalarProperty Name="ChangeCategoryID" ColumnName="ChangeCategoryID" />
          <ScalarProperty Name="ClientID" ColumnName="ClientID" />
          <ScalarProperty Name="Descr" ColumnName="Descr" />
          <ScalarProperty Name="DateChange" ColumnName="DateChange" />
          <ScalarProperty Name="MoneyHand" ColumnName="MoneyHand" />
          <ScalarProperty Name="Commissor" ColumnName="Commissor" />
          <ScalarProperty Name="DateReturn" ColumnName="DateReturn" />
          <ScalarProperty Name="Photo" ColumnName="Photo" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="ChangeCategories">
      <EntityTypeMapping TypeName="PawnShopModel.ChangeCategory">
        <MappingFragment StoreEntitySet="ChangeCategory">
          <ScalarProperty Name="ChangeCategoryID" ColumnName="ChangeCategoryID" />
          <ScalarProperty Name="Name" ColumnName="Name" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="Clients">
      <EntityTypeMapping TypeName="PawnShopModel.Client">
        <MappingFragment StoreEntitySet="Client">
          <ScalarProperty Name="ClientID" ColumnName="ClientID" />
          <ScalarProperty Name="Surname" ColumnName="Surname" />
